{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven Compile",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["compile"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Maven Test",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["test"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": ["$maven"]
    }
  ]
}
